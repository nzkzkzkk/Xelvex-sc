# ============================================================
# Admin System Environment Variables (.env.example)
# IMPORTANT: Never commit actual secret keys to git repositories!
# ============================================================

# Database connection strings (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# Network & Host configuration
NODE_ENV="development"
PORT=3001
ADMIN_APP_URL="http://localhost:3001"
STOREFRONT_ORIGIN="http://localhost:3000"

# Application Encryption Key (Must be 32 bytes hex string = 64 characters for AES-256-GCM)
# Example generation: openssl rand -hex 32
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Admin Session Secret (Used for cookie cryptographic signature and session tokens)
# Example generation: openssl rand -hex 32
ADMIN_SESSION_SECRET="your_very_secure_admin_session_secret_key_at_least_32_bytes_long"

# Cloudflare Zero Trust / Cloudflare Access Policy (Production only)
# Required when running behind Cloudflare Access
CF_ACCESS_TEAM_NAME="your-team-domain"
CF_ACCESS_AUDIENCE_TAG="your-audience-tag-from-cloudflare-zero-trust"
REQUIRE_CLOUDFLARE_ACCESS="false"

# IP Allowlist (Optional CIDR / comma-separated IPs)
# ADMIN_IP_ALLOWLIST="192.168.1.0/24,1.2.3.4"
